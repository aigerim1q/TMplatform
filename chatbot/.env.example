# Optional: connect main frontend (npm run dev) to the Go chatbot backend.
# Uncomment and set when the backend is running (e.g. ./run_chatbot_http.sh).
# CHATBOT_API_URL=http://localhost:8080

# LLM (for local mode when CHATBOT_API_URL is not set)
# DEEPSEEK_API_KEY=your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
